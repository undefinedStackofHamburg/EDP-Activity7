{
  /*
    appsettings.json
    ────────────────
    Configuration file read by the app on startup.

    ConnectionStrings → where your database lives
    ──────────────────────────────────────────────
    Server    = localhost      (XAMPP MySQL runs here)
    Port      = 3306           (default MySQL port)
    Database  = libsys_db      (the DB you created with the .sql file)
    User Id   = root           (default XAMPP MySQL username)
    Password  =                (XAMPP MySQL has no password by default)

    ⚠ If you set a MySQL root password in XAMPP,
      put it in the Password= field below.

    Logging → controls how much info is printed to console
    AllowedHosts → * means accept requests from any origin
  */
  "ConnectionStrings": {
    "LibSysDb": "Server=localhost;Port=3306;Database=libsys_db;User Id=root;Password=;CharSet=utf8mb4;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
